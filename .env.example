# Node does not load this automatically. Use: node --env-file=.env server/main.mjs
HOST=127.0.0.1
PORT=4310
TERN_DATA_DIR=.tern-data
# Required behind a reverse proxy so devices receive the correct download URL.
# TERN_PUBLIC_URL=https://updates.example.com
# Enable only behind an exclusive trusted reverse proxy that replaces X-Forwarded-For.
# TERN_TRUST_PROXY=true
# On Render, RENDER_EXTERNAL_URL supplies this automatically. Set
# TERN_PUBLIC_URL explicitly when switching to a custom domain.
# Optional: supply a stable admin key through the environment instead of a file.
# TERN_ADMIN_TOKEN=replace-with-a-private-random-key-at-least-32-characters-long
