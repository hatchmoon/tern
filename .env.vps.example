# Public DNS hostname only; no scheme, path, wildcard, or port.
TERN_DOMAIN=updates.example.com
# Email used for certificate registration/expiry notices.
ACME_EMAIL=admin@example.com
# The server generates its admin key inside the persistent tern-data volume.
# Keep that key out of this file and Flutter app configuration.
# Without a domain, set TERN_DOMAIN to the public IPv4 address and use:
# TERN_CADDYFILE=./deploy/Caddyfile.ip
# The IP configuration uses Let's Encrypt's shortlived profile. Email is optional.
# When moving from an IP to a domain while retaining installed app support, use:
# TERN_CADDYFILE=./deploy/Caddyfile.domain-ip
# TERN_LEGACY_IP=43.106.48.165
# Keep existing tern.yaml base_url values for already-published releases.
